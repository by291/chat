# Initialize with node scripts/init-env.mjs to create random local credentials.
DATABASE_URL=postgres://chat:CHANGE_ME@127.0.0.1:55432/chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=chat
VALKEY_URL=redis://127.0.0.1:56379
ALLOWED_ORIGINS=http://localhost:5173
BIND_ADDR=127.0.0.1:8080
INTERNAL_BIND_ADDR=127.0.0.1:8081
COOKIE_SECURE=false
CENTRIFUGO_API_URL=http://127.0.0.1:8000/api
CENTRIFUGO_API_KEY=CHANGE_ME
INTERNAL_PROXY_KEY=CHANGE_ME
SEAWEED_ACCESS_KEY=chat-local
SEAWEED_SECRET_KEY=CHANGE_ME
RUST_LOG=chat_server=info,tower_http=info
GROUP_MAX_MEMBERS=100
MEDIA_S3_INTERNAL_ENDPOINT=http://127.0.0.1:8333
MEDIA_S3_PUBLIC_ENDPOINT=http://localhost:8336
MEDIA_S3_BUCKET=chat-media
MEDIA_S3_REGION=us-east-1
MEDIA_USER_QUOTA_BYTES=1073741824
CHAT_MEDIA_ORIGIN=http://localhost:8336

# Root Compose loopback bindings. Keep application URLs above aligned when changing
# these locally; test/restore launchers provide their own isolated values.
POSTGRES_PORT=55432
VALKEY_PORT=56379
CENTRIFUGO_PORT=8000
INTERNAL_PROXY_PORT=8081
SEAWEED_S3_PORT=8333
MEDIA_GATEWAY_PORT=8336
