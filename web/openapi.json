{
  "components": {
    "schemas": {
      "ApiErrorBody": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "type": "object"
      },
      "ConversationEvent": {
        "properties": {
          "envelope": {
            "$ref": "#/components/schemas/EventEnvelope"
          },
          "payload": {
            "$ref": "#/components/schemas/ConversationEventPayload"
          }
        },
        "required": [
          "envelope",
          "payload"
        ],
        "type": "object"
      },
      "ConversationEventKind": {
        "enum": [
          "conversation.created",
          "message.created",
          "receipt.updated"
        ],
        "type": "string"
      },
      "ConversationEventPayload": {
        "oneOf": [
          {
            "properties": {
              "data": {
                "properties": {
                  "initiator_id": {
                    "$ref": "#/components/schemas/UserId"
                  }
                },
                "required": [
                  "initiator_id"
                ],
                "type": "object"
              },
              "type": {
                "enum": [
                  "conversation.created"
                ],
                "type": "string"
              }
            },
            "required": [
              "data",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "data": {
                "$ref": "#/components/schemas/MessageView"
              },
              "type": {
                "enum": [
                  "message.created"
                ],
                "type": "string"
              }
            },
            "required": [
              "data",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "data": {
                "$ref": "#/components/schemas/ReceiptData"
              },
              "type": {
                "enum": [
                  "receipt.updated"
                ],
                "type": "string"
              }
            },
            "required": [
              "data",
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "ConversationId": {
        "format": "uuid",
        "type": "string"
      },
      "ConversationView": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ConversationId"
          },
          "last_message": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MessageView"
              }
            ]
          },
          "latest_event_seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "my_read_seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "peer": {
            "$ref": "#/components/schemas/UserView"
          },
          "peer_read_seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "unread_count": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "peer",
          "latest_event_seq",
          "unread_count",
          "my_read_seq",
          "peer_read_seq"
        ],
        "type": "object"
      },
      "DirectInput": {
        "properties": {
          "peer_id": {
            "$ref": "#/components/schemas/UserId"
          }
        },
        "required": [
          "peer_id"
        ],
        "type": "object"
      },
      "EphemeralEvent": {
        "oneOf": [
          {
            "properties": {
              "conversation_id": {
                "$ref": "#/components/schemas/ConversationId"
              },
              "expires_at": {
                "format": "date-time",
                "type": "string"
              },
              "is_typing": {
                "type": "boolean"
              },
              "kind": {
                "enum": [
                  "typing.changed"
                ],
                "type": "string"
              },
              "user_id": {
                "$ref": "#/components/schemas/UserId"
              }
            },
            "required": [
              "conversation_id",
              "user_id",
              "is_typing",
              "expires_at",
              "kind"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "presence.changed"
                ],
                "type": "string"
              },
              "user_id": {
                "$ref": "#/components/schemas/UserId"
              }
            },
            "required": [
              "user_id",
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "EventEnvelope": {
        "properties": {
          "conversation_id": {
            "$ref": "#/components/schemas/ConversationId"
          },
          "event_id": {
            "$ref": "#/components/schemas/EventId"
          },
          "event_seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "kind": {
            "$ref": "#/components/schemas/ConversationEventKind"
          },
          "schema_version": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "schema_version",
          "event_id",
          "kind",
          "conversation_id",
          "event_seq"
        ],
        "type": "object"
      },
      "EventId": {
        "format": "uuid",
        "type": "string"
      },
      "EventPage": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/ConversationEvent"
            },
            "type": "array"
          },
          "has_more": {
            "type": "boolean"
          },
          "last_seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "snapshot_seq": {
            "$ref": "#/components/schemas/Seq"
          }
        },
        "required": [
          "events",
          "last_seq",
          "snapshot_seq",
          "has_more"
        ],
        "type": "object"
      },
      "LoginInput": {
        "properties": {
          "device_label": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password",
          "device_label"
        ],
        "type": "object"
      },
      "MessageId": {
        "format": "uuid",
        "type": "string"
      },
      "MessageSnapshot": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MessageView"
            },
            "type": "array"
          },
          "next_before": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Seq"
              }
            ]
          },
          "snapshot_seq": {
            "$ref": "#/components/schemas/Seq"
          }
        },
        "required": [
          "items",
          "snapshot_seq"
        ],
        "type": "object"
      },
      "MessageView": {
        "properties": {
          "body": {
            "type": "string"
          },
          "client_message_id": {
            "format": "uuid",
            "type": "string"
          },
          "conversation_id": {
            "$ref": "#/components/schemas/ConversationId"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "created_seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "id": {
            "$ref": "#/components/schemas/MessageId"
          },
          "sender_id": {
            "$ref": "#/components/schemas/UserId"
          }
        },
        "required": [
          "id",
          "conversation_id",
          "sender_id",
          "client_message_id",
          "created_seq",
          "body",
          "created_at"
        ],
        "type": "object"
      },
      "Page_ConversationView": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "id": {
                  "$ref": "#/components/schemas/ConversationId"
                },
                "last_message": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/components/schemas/MessageView"
                    }
                  ]
                },
                "latest_event_seq": {
                  "$ref": "#/components/schemas/Seq"
                },
                "my_read_seq": {
                  "$ref": "#/components/schemas/Seq"
                },
                "peer": {
                  "$ref": "#/components/schemas/UserView"
                },
                "peer_read_seq": {
                  "$ref": "#/components/schemas/Seq"
                },
                "unread_count": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "peer",
                "latest_event_seq",
                "unread_count",
                "my_read_seq",
                "peer_read_seq"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ReadInput": {
        "properties": {
          "message_seq": {
            "$ref": "#/components/schemas/Seq"
          }
        },
        "required": [
          "message_seq"
        ],
        "type": "object"
      },
      "ReadResult": {
        "properties": {
          "my_read_seq": {
            "$ref": "#/components/schemas/Seq"
          }
        },
        "required": [
          "my_read_seq"
        ],
        "type": "object"
      },
      "RealtimeEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/EventEnvelope"
          },
          {
            "$ref": "#/components/schemas/EphemeralEvent"
          }
        ]
      },
      "ReceiptData": {
        "properties": {
          "message_seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "user_id": {
            "$ref": "#/components/schemas/UserId"
          }
        },
        "required": [
          "user_id",
          "message_seq"
        ],
        "type": "object"
      },
      "RegisterInput": {
        "properties": {
          "display_name": {
            "type": "string"
          },
          "invitation": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "invitation",
          "username",
          "display_name",
          "password"
        ],
        "type": "object"
      },
      "SendMessageInput": {
        "properties": {
          "body": {
            "type": "string"
          },
          "client_message_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "client_message_id",
          "body"
        ],
        "type": "object"
      },
      "Seq": {
        "pattern": "^(0|[1-9][0-9]*)$",
        "type": "string"
      },
      "SessionId": {
        "format": "uuid",
        "type": "string"
      },
      "SessionView": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "device_label": {
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/SessionId"
          },
          "is_current": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "device_label",
          "created_at",
          "expires_at",
          "is_current"
        ],
        "type": "object"
      },
      "TypingInput": {
        "properties": {
          "is_typing": {
            "type": "boolean"
          }
        },
        "required": [
          "is_typing"
        ],
        "type": "object"
      },
      "UpdateProfile": {
        "properties": {
          "display_name": {
            "type": "string"
          }
        },
        "required": [
          "display_name"
        ],
        "type": "object"
      },
      "UserId": {
        "format": "uuid",
        "type": "string"
      },
      "UserStatus": {
        "properties": {
          "online": {
            "type": "boolean"
          }
        },
        "required": [
          "online"
        ],
        "type": "object"
      },
      "UserView": {
        "properties": {
          "display_name": {
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/UserId"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "display_name"
        ],
        "type": "object"
      }
    }
  },
